<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

DirectoryIndex index.html index.php

# Redirect /listsarpras to root
RewriteRule ^listsarpras/?$ / [R=301,L]

# Serve kiosk
RewriteRule ^kiosk/?$ /kiosk/index.html [L]

# Normal file or directory exists
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Fallback for SPA routing
RewriteRule ^ index.html [L]
</IfModule>
